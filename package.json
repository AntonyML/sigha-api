  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.9",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "chromedriver": "^142.0.1",
    "knip": "^6.26.0",
    "selenium-webdriver": "^4.38.0",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"bun run\"",
    "start:render": "bun dist/main.js",
    "start:dev": "nest start --watch --exec \"bun run\"",
    "start:infisical": "infisical run -- nest start --watch --exec \"bun run\"",
    "start:prod": "bun dist/main.js",
    "start:prod:infisical": "infisical run --env=prod -- bun dist/main.js",
    "test": "bun test",
    "test:infisical": "infisical run -- bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:junit": "bun test --reporter=junit --reporter-outfile=test-results/junit.xml",
    "clean": "bun -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint:deps": "knip",
    "outdated": "bun outdated"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.0.0"
  }
}