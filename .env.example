# =============================================================================
# Sistema Integral de Gestión Holística y de Asistencia — Backend env example
# Copy to `.env` (development) or `.env.production` and fill the real values.
# NEVER commit `.env` or `.env.production` with real secrets.
# =============================================================================

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Rate limiting (ThrottlerModule - global guard)
# Max requests allowed per IP within THROTTLE_TTL milliseconds.
# Defaults: 60000 ms (60 s) window, 100 requests. Lower the limit in
# production (e.g. 30) if you need stricter protection.
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Database (Postgres / Supabase — ÉPICA 2 ✅)
# Set DATABASE_URL for managed Postgres (Supabase, Railway, Render, etc.).
# Leave it empty to use the discrete DB_* vars below (e.g. local Postgres in docker).
# The login role must be a member of sigha_app after migration 024 is applied.
# -----------------------------------------------------------------------------
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=sigha

# Set DB_SSL=true for managed Postgres with TLS (Supabase pooler, RDS, etc.).
# DATABASE_URL with sslmode=require is also auto-detected.
DB_SSL=false

# -----------------------------------------------------------------------------
# Database Logging (TypeORM)
# Set TYPEORM_LOGGING=true ONLY for debugging specific query issues
# Default: false (only SQL errors are logged, not all queries)
# -----------------------------------------------------------------------------
TYPEORM_LOGGING=false

# -----------------------------------------------------------------------------
# Logging Configuration
# LOG_LEVEL: Minimum level to log (fatal, error, warn, info, http, audit, debug, trace)
#            Production default: info
#            Development default: trace
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Supabase Storage (for file uploads - logos, assets)
# Get from: Supabase Dashboard > Project Settings > API
# SUPABASE_URL: Project URL (https://<project-ref>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: service_role secret (NOT anon/public)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Legacy: MySQL (kept temporarily for downgrade path; will be removed in a
# later epic). Install `mysql2` only if you intend to run against MySQL.
# -----------------------------------------------------------------------------
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_NAME=sigha

# -----------------------------------------------------------------------------
# Render (deploy de sigha-api)
# El build/install/start vive en render.yaml (Bun). Aquí solo van variables.
# En el dashboard de Render (Environment) define como Secret los valores reales.
# Nunca commitees .env ni .env.production con secretos.
# Requeridas en producción:
#   NODE_ENV=production, DATABASE_URL (o DB_*), DB_SSL=true,
#   JWT_SECRET (>=16 chars), CORS_ORIGINS (origen del front, ej. https://<tu-front>.onrender.com)
# Opcionales según uso:
#   RESEND_API_KEY, RESEND_FROM_EMAIL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# Render inyecta PORT automáticamente; main.ts ya usa process.env.PORT con fallback 3000.
# Health check: GET /health (público, sin JWT, sin DB).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Mailbridge (email management microservice)
# Endpoint for transactional sends: https://mailer.tonyml.com/api/send
# -----------------------------------------------------------------------------
MAILER_BASE_URL=https://mailer.tonyml.com/api/send
MAILER_APP_KEY=ml_live_37390847cd8c4b6eabf85b2ea3f90f99

# -----------------------------------------------------------------------------
# Resend (legacy transactional email - opcional / fallback)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Sistema Integral de Gestión Holística y de Asistencia

